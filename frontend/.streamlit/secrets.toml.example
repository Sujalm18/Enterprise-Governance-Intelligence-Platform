# Streamlit Secrets Configuration Example
# ===========================================
# This file shows the required secrets for Streamlit Cloud deployment.
# 
# LOCAL DEVELOPMENT:
#   - Copy this to .streamlit/secrets.toml
#   - Set API_BASE_URL to your local backend (e.g., http://localhost:8000)
#   - Run: streamlit run app.py
#
# STREAMLIT CLOUD:
#   - Go to your app's settings (https://share.streamlit.io)
#   - Navigate to "Secrets"
#   - Add the content below, updating API_BASE_URL with your Render backend URL
#   - Streamlit Cloud will automatically encrypt and manage the secrets

# Backend API URL
# For local development: http://localhost:8000
# For production (Render): https://your-app-name.onrender.com
API_BASE_URL = "https://your-render-backend.onrender.com"
